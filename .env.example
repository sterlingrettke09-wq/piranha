# Mapbox PUBLIC token (pk.) — REQUIRED. Inlined into the client bundle at
# BUILD time for the map, parcel mini-map, and address search — so restrict it
# by URL (your production domain) in the Mapbox dashboard. Set in Netlify →
# Site settings → Environment variables (and locally in .env).
# https://account.mapbox.com/
VITE_MAPBOX_TOKEN=

# Mapbox SERVER token — OPTIONAL. Used only by the functions' reverse geocoder.
# Falls back to VITE_MAPBOX_TOKEN if unset; a separate token here lets the
# public one stay tightly URL-restricted.
MAPBOX_TOKEN=

# Google Gemini key — OPTIONAL. Turns on the Ask assistant. Without it the
# assistant shows "not available yet"; everything else works. Set a billing
# alert on this key — the in-process rate limiter is best-effort.
GEMINI_API_KEY=

# Passphrase for the owner-only /admin search log — OPTIONAL. Without it the
# admin endpoint returns "not configured".
ADMIN_KEY=

# Netlify Blobs (search-log store) — OPTIONAL. Only needed if the deploy does
# not auto-inject the Blobs environment; see netlify/functions/lib/searchLog.ts.
# NETLIFY_BLOBS_SITE_ID=
# NETLIFY_BLOBS_TOKEN=

# ── Sign-in (accounts + watchlists) ─────────────────────────────────────────
# Transactional email for the one-time login link. REQUIRED for sign-in.
# Without BOTH of these, /api/auth-request still answers 204 — it has to, or the
# response becomes an account-enumeration oracle — and logs
# `status: "not-configured"`. So nobody can sign in and the function log is the
# only place that says why. Check it after the first deploy.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Absolute origin used to build the sign-in link, e.g.
# https://thepiranhaproject.com — OPTIONAL. Falls back to the request Host,
# which is correct except behind a proxy that rewrites it.
SITE_ORIGIN=
